HH_SEARCH_URL=https://hh.ru/search/vacancy?text=frontend&area=1

USER_DATA_DIR=user-data/hh-profile
DATABASE_PATH=data/hh.db
STORAGE_STATE_PATH=cookies/hh-storage.json
APPLIED_DB_PATH=data/applied.json

MAX_APPLICATIONS=15
MAX_PAGES=3
DELAY_MIN_MS=4000
DELAY_MAX_MS=9000
HEADLESS=false

SKIP_VACANCIES_WITH_TESTS=true
COVER_LETTER_FILE=cover-letter.txt

HUMAN_BROWSE_CHANCE=0.06
HUMAN_IDLE_CHANCE=0.03
NAVIGATION_ENTROPY_CHANCE=0.08
SLOW_MO=0
USE_SYSTEM_CHROME=true

# Cooldowns (SQLite)
COMPANY_COOLDOWN_HOURS=24
FAILED_RETRY_DAYS=3
DAILY_LIMIT=40
HOURLY_LIMIT=12

# Ranking: SCORE_ENABLED=true чтобы фильтровать по стеку
SCORE_ENABLED=false
SCORE_THRESHOLD=0
POSITIVE_KEYWORDS=typescript,javascript,node,nest,react,frontend
NEGATIVE_KEYWORDS=php,python,java,1c,qa,devops,designer
