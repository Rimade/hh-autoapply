# URL страницы поиска (скопируй из браузера после настройки фильтров)
HH_SEARCH_URL=https://hh.ru/search/vacancy?text=frontend&area=1

# Persistent-профиль браузера (cookies, localStorage, fingerprint)
USER_DATA_DIR=user-data/hh-profile

# Старый формат сессии — один раз импортируется в профиль, если есть
STORAGE_STATE_PATH=cookies/hh-storage.json

# Лимиты за один запуск
MAX_APPLICATIONS=15
MAX_PAGES=3

# Пауза между откликами (мс) — случайный разброс, не фиксированная
DELAY_MIN_MS=4000
DELAY_MAX_MS=9000

# false — видишь браузер (рекомендуется), true — в фоне
HEADLESS=false

# true — пропускать вакансии с тестами/анкетами
SKIP_VACANCIES_WITH_TESTS=true

# Сопроводительное письмо
COVER_LETTER_FILE=cover-letter.txt

# Вероятность «просто открыть вакансию» без отклика (0–0.2)
HUMAN_BROWSE_CHANCE=0.06

# Редкая длинная пауза 20–40 сек (0–0.1)
HUMAN_IDLE_CHANCE=0.03

# Замедление действий в мс (0 = выкл)
SLOW_MO=0

# true — системный Chrome вместо bundled Chromium (если установлен)
USE_SYSTEM_CHROME=false

APPLIED_DB_PATH=data/applied.json
