# URL страницы поиска (скопируй из браузера после настройки фильтров)
HH_SEARCH_URL=https://hh.ru/search/vacancy?text=frontend&area=1

# Лимиты за один запуск
MAX_APPLICATIONS=15
MAX_PAGES=3

# Пауза между откликами (мс) — не ставь слишком мало
DELAY_MIN_MS=4000
DELAY_MAX_MS=9000

# false — видишь браузер (удобно для отладки), true — в фоне
HEADLESS=false

# true (по умолчанию) — пропускать вакансии с тестами/анкетами
SKIP_VACANCIES_WITH_TESTS=true

# Сопроводительное письмо (рекомендуется файл — удобно для длинного текста)
COVER_LETTER_FILE=cover-letter.txt
# или одной строкой: COVER_LETTER="Здравствуйте!\\n\\nМеня заинтересовала вакансия..."

STORAGE_STATE_PATH=cookies/hh-storage.json
APPLIED_DB_PATH=data/applied.json
